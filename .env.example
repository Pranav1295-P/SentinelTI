# Copy to .env. Everything under "API keys" is optional: the pipeline still runs without it.

ENVIRONMENT=development

# Postgres (docker-compose publishes it on localhost:5433)
DATABASE_URL_ASYNC=postgresql+asyncpg://mpuser:mppass@localhost:5433/malware_platform
DATABASE_URL_SYNC=postgresql+psycopg://mpuser:mppass@localhost:5433/malware_platform

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Quarantine and reports
STORAGE_PATH=./storage
MAX_UPLOAD_BYTES=104857600

# Auth. Generate with: openssl rand -hex 32
SECRET_KEY=
ALLOW_REGISTRATION=false
# Set to true once the site is served over HTTPS
COOKIE_SECURE=false

# Graph database (agent 5). Leave NEO4J_URI blank to skip graph matching.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# --- API keys ---

# Any provider:model that LangChain's init_chat_model accepts, for example
#   anthropic:claude-opus-5-5   groq:openai/gpt-oss-120b
#   mistralai:mistral-large-latest   openai:gpt-5
# Blank key = agents run on their required tools with rule-based explanations.
LLM_MODEL=anthropic:claude-opus-5-5
LLM_API_KEY=

# Hash lookups only. The sample itself is never uploaded.
VIRUSTOTAL_API_KEY=
OTX_API_KEY=

# Optional tracing. Sends sample-derived strings to LangSmith, so it is off by default.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=sentinelti
