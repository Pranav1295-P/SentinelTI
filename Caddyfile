{$SITE_ADDRESS::80} {
	encode gzip

	request_body {
		max_size 110MB
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
		-Server
	}

	handle /api/* {
		# flush_interval -1 keeps server-sent events live instead of buffered.
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}

	handle {
		header Content-Security-Policy "default-src 'self'; script-src 'self' https://cdnjs.cloudflare.com https://unpkg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		# Browsers may keep files but must revalidate, or they run stale code after an update.
		header Cache-Control "no-cache"
		root * /srv
		file_server
	}
}
